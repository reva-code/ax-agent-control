+// limitations under the License.
+
+package cmd
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/grpc"
+	"google.golang.org/protobuf/proto"
+)
+
+type fakeSelectorUpdater struct {
+	stored *ateapipb.Actor
+	sent   *ateapipb.Actor
+}
+
+func (f *fakeSelectorUpdater) GetActor(_ context.Context, _ *ateapipb.GetActorRequest, _ ...grpc.CallOption) (*ateapipb.Actor, error) {
+	return proto.CloneOf(f.stored), nil
+}
+
+func (f *fakeSelectorUpdater) UpdateActor(_ context.Context, req *ateapipb.UpdateActorRequest, _ ...grpc.CallOption) (*ateapipb.Actor, error) {
+	f.sent = req.GetActor()
+	return req.GetActor(), nil
+}
+
+func TestUpdateActorSelector(t *testing.T) {
+	stored := &ateapipb.Actor{
+		Metadata:       &ateapipb.ResourceMetadata{Atespace: "default", Name: "a", Version: 7},
+		ActorTemplate:  &ateapipb.ObjectRef{Atespace: "default", Name: "tmpl"},
+		WorkerSelector: &ateapipb.Selector{MatchLabels: map[string]string{"node": "old"}},
+	}
+	for _, tc := range []struct {
+		name   string
+		labels map[string]string
+		want   map[string]string
+	}{
+		{name: "set", labels: map[string]string{"node": "kind-worker2"}, want: map[string]string{"node": "kind-worker2"}},
+		{name: "clear", labels: nil, want: nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := &fakeSelectorUpdater{stored: stored}
+			var out bytes.Buffer
+			r := &updateActorSelectorRunner{updater: f, actor: &ateapipb.ObjectRef{Atespace: "default", Name: "a"}, labels: tc.labels, stdout: &out}
+			if err := r.Run(context.Background()); err != nil {
+				t.Fatalf("Run: %v", err)
+			}
+			if got := f.sent.GetWorkerSelector().GetMatchLabels(); !equalLabels(got, tc.want) {
+				t.Errorf("selector sent = %v, want %v", got, tc.want)
+			}
+			// The rest of the actor, including the version precondition, is sent back unchanged.
+			if f.sent.GetMetadata().GetVersion() != 7 || f.sent.GetActorTemplate().GetName() != "tmpl" {
+				t.Errorf("update did not preserve the stored actor: %v", f.sent)
+			}
+		})
+	}
+}
+
+func TestParseSelectorLabels(t *testing.T) {
+	if _, err := parseSelectorLabels([]string{"novalue"}); err == nil {
+		t.Error("want error for a label without '='")
+	}
+	got, err := parseSelectorLabels([]string{"node=kind-worker", "zone=a"})
+	if err != nil || !equalLabels(got, map[string]string{"node": "kind-worker", "zone": "a"}) {
+		t.Errorf("parseSelectorLabels = %v, %v", got, err)
+	}
+}
+
+func equalLabels(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if b[k] != v {
+			return false
+		}
+	}
+	return true
+}
