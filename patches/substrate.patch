+// limitations under the License.
+
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+
+	"github.com/agent-substrate/substrate/internal/ateclient"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/spf13/cobra"
+	"google.golang.org/grpc"
+)
+
+var actorSelectorFlags struct {
+	atespace string
+	labels   []string
+}
+
+var updateActorSelectorCmd = &cobra.Command{
+	Use:   "actor-selector <actor-name>",
+	Short: "Set the worker labels an actor must be placed on; takes effect on its next resume",
+	Long: `Set an actor's worker selector: the labels a worker must carry to host it.
+The scheduler applies it on the actor's next resume, so suspending an actor and
+resuming it with a different selector moves it onto matching workers.
+
+  kubectl ate update actor-selector my-actor -a default --label node=kind-worker2
+  kubectl ate update actor-selector my-actor -a default    # no --label: clear it`,
+	Args: cobra.ExactArgs(1),
+	RunE: runUpdateActorSelector,
+}
+
+// actorSelectorUpdater abstracts the RPCs update actor-selector makes.
+type actorSelectorUpdater interface {
+	GetActor(ctx context.Context, req *ateapipb.GetActorRequest, opts ...grpc.CallOption) (*ateapipb.Actor, error)
+	UpdateActor(ctx context.Context, req *ateapipb.UpdateActorRequest, opts ...grpc.CallOption) (*ateapipb.Actor, error)
+}
+
+type updateActorSelectorRunner struct {
+	updater actorSelectorUpdater
+	actor   *ateapipb.ObjectRef
+	labels  map[string]string
+	stdout  io.Writer
+}
+
+func (r *updateActorSelectorRunner) Run(ctx context.Context) error {
+	// UpdateActor replaces the whole actor, guarded by the version read here.
+	actor, err := r.updater.GetActor(ctx, &ateapipb.GetActorRequest{Actor: r.actor})
+	if err != nil {
+		return fmt.Errorf("failed to get actor %s/%s: %w", r.actor.GetAtespace(), r.actor.GetName(), err)
+	}
+	if len(r.labels) == 0 {
+		actor.WorkerSelector = nil
+	} else {
+		actor.WorkerSelector = &ateapipb.Selector{MatchLabels: r.labels}
+	}
+	updated, err := r.updater.UpdateActor(ctx, &ateapipb.UpdateActorRequest{Actor: actor})
+	if err != nil {
+		return fmt.Errorf("failed to update actor %s/%s: %w", r.actor.GetAtespace(), r.actor.GetName(), err)
+	}
+	fmt.Fprintf(r.stdout, "actor %q worker selector: %s\n", r.actor.GetName(), formatLabels(updated.GetWorkerSelector().GetMatchLabels()))
+	return nil
+}
+
+func parseSelectorLabels(pairs []string) (map[string]string, error) {
+	labels := make(map[string]string, len(pairs))
+	for _, p := range pairs {
+		k, v, ok := strings.Cut(p, "=")
+		if !ok || k == "" {
+			return nil, fmt.Errorf("invalid --label %q: want key=value", p)
+		}
+		labels[k] = v
+	}
+	return labels, nil
+}
+
+func formatLabels(labels map[string]string) string {
+	if len(labels) == 0 {
+		return "(none)"
+	}
+	pairs := make([]string, 0, len(labels))
+	for k, v := range labels {
+		pairs = append(pairs, k+"="+v)
+	}
+	sort.Strings(pairs)
+	return strings.Join(pairs, ",")
+}
+
+func runUpdateActorSelector(cmd *cobra.Command, args []string) error {
+	labels, err := parseSelectorLabels(actorSelectorFlags.labels)
+	if err != nil {
+		return err
+	}
+	ctx := cmd.Context()
+	apiClient, err := ateclient.NewClient(ctx, kubeconfig, k8sContext, endpoint, tokenFile, traceEnabled)
+	if err != nil {
+		return fmt.Errorf("failed to connect to ate-api-server: %w", err)
+	}
+	defer apiClient.Close()
+
+	runner := &updateActorSelectorRunner{
+		updater: apiClient,
+		actor:   &ateapipb.ObjectRef{Atespace: actorSelectorFlags.atespace, Name: args[0]},
+		labels:  labels,
+		stdout:  cmd.OutOrStdout(),
+	}
+	return runner.Run(ctx)
+}
+
+func init() {
+	updateActorSelectorCmd.Flags().StringVarP(&actorSelectorFlags.atespace, "atespace", "a", "", "Atespace the actor lives in (required)")
+	updateActorSelectorCmd.Flags().StringArrayVar(&actorSelectorFlags.labels, "label", nil, "Worker label the actor requires, as key=value; repeatable. Omit to clear the selector")
+	_ = updateActorSelectorCmd.MarkFlagRequired("atespace")
+	updateCmd.AddCommand(updateActorSelectorCmd)
+}
