diff --git a/Dockerfile.task-runner-claude b/Dockerfile.task-runner-claude
new file mode 100644
index 0000000..42cb799
--- /dev/null
+++ b/Dockerfile.task-runner-claude
@@ -0,0 +1,39 @@
+# Extends AX's own task-runner image with git + the Claude Code CLI, so a
+# Task can run Claude non-interactively against a cloned Workspace repo.
+# Mirrors tag-transition-pipeline/consumer/Dockerfile's approach.
+
+FROM python:3.12-slim
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    git \
+    curl \
+    ca-certificates \
+    openssh-client \
+    procps \
+    bash \
+    gnupg \
+    libcap2-bin \
+    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
+    && apt-get install -y --no-install-recommends nodejs \
+    && npm install -g @anthropic-ai/claude-code \
+    && apt-get purge -y curl gnupg && apt-get autoremove -y \
+    && rm -rf /var/lib/apt/lists/* /var/lib/apt/lists/partial
+
+RUN pip install --no-cache-dir google-antigravity
+
+# claude refuses --dangerously-skip-permissions as root. Agent Substrate's
+# gVisor sandbox strips CAP_SETUID/CAP_SETGID/CAP_CHOWN at runtime, so
+# dropping privileges after start (su/setuid) is not possible here -- the
+# container must start as this user. ax-task-runner's health probe binds
+# port 80 by default, which normally needs root; setcap grants that one
+# capability to the binary itself at build time so it still works non-root.
+RUN groupadd -g 1000 claudeuser && useradd -u 1000 -g claudeuser -m -s /bin/bash claudeuser
+
+COPY bin/linux_arm64/ax-task-runner /usr/local/bin/ax-task-runner
+COPY cmd/ax-task-runner/antigravity_bootstrap.py /usr/local/bin/antigravity_bootstrap.py
+RUN setcap 'cap_net_bind_service=+ep' /usr/local/bin/ax-task-runner
+
+USER claudeuser
+ENV HOME=/home/claudeuser
+
+ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
