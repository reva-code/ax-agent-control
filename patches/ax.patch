+func TestTaskReconciler_NoCapacityStaysSuspended(t *testing.T) {
+	ctx := context.Background()
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	defer lis.Close()
+
+	mockSrv := &mockControlServer{resumeErr: status.Error(codes.ResourceExhausted, "no free workers available")}
+	grpcServer := grpc.NewServer()
+	ateapipb.RegisterControlServer(grpcServer, mockSrv)
+	go grpcServer.Serve(lis)
+	defer grpcServer.Stop()
+
+	client, err := substrate.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatalf("failed to create substrate client: %v", err)
+	}
+	defer client.Close()
+
+	reconciler := controller.NewTaskReconciler(client, "test-template", "ax-system")
+	reconciler.SecretResolver = noSecrets
+	task := &v1alpha1.Task{
+		ApiVersion: v1alpha1.APIVersion,
+		Kind:       v1alpha1.KindTask,
+		Metadata:   &v1alpha1.ObjectMeta{Name: "big-task", Atespace: "default"},
+		Spec: &v1alpha1.TaskSpec{
+			Image:     "ghrc.io/my-org/my-image",
+			Resources: &v1alpha1.ResourceReqs{Limits: &v1alpha1.ResourceList{Cpu: "1", Memory: "1Gi"}},
+		},
+		Status: &v1alpha1.TaskStatus{Phase: "Running"},
+	}
+
+	reconciled, err := reconciler.Reconcile(ctx, task)
+	if status.Code(err) != codes.ResourceExhausted {
+		t.Fatalf("Reconcile error = %v, want ResourceExhausted", err)
+	}
+	if reconciled == nil || reconciled.Status.Phase != "Suspended" {
+		t.Fatalf("phase = %v, want Suspended (waiting for capacity, not Failed)", reconciled.GetStatus().GetPhase())
+	}
+	var reason string
+	for _, c := range reconciled.Status.Conditions {
+		if c.Type == "Ready" {
+			reason = c.Reason
+		}
+	}
+	if reason != "WaitingForCapacity" {
+		t.Errorf("Ready reason = %q, want WaitingForCapacity", reason)
+	}
+	// The task's declared limits reach the template, where Substrate books them.
+	got := map[string]string{}
+	for _, l := range mockSrv.lastTemplate.GetResources().GetLimits() {
+		got[l.GetName()] = l.GetQuantity()
+	}
+	if got["cpu"] != "1" || got["memory"] != "1Gi" {
+		t.Errorf("template limits = %v, want cpu=1 memory=1Gi", got)
+	}
+}
