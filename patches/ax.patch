+// snapshotScope picks what pause/suspend snapshots keep. DATA (the default)
+// keeps only the workspace volume and resumes from the golden snapshot, so the
+// running task's memory is lost. AX_SNAPSHOT_SCOPE=full keeps process memory
+// too, so a suspended task resumes exactly where it stopped.
+func snapshotScope() ateapipb.SnapshotContentScope {
+	if strings.EqualFold(os.Getenv("AX_SNAPSHOT_SCOPE"), "full") {
+		return ateapipb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_FULL
+	}
+	return ateapipb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA
+}
