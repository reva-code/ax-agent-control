+// TemplateResources converts a Task's resource limits into Substrate template
+// limits. Substrate books them against a worker's capacity when it places the
+// actor and sizes the sandbox to them, so a Task that declares limits is only
+// placed where it fits. Nil means the actor declares nothing and books nothing.
+func TemplateResources(limits *v1alpha1.ResourceList) *ateapipb.Resources {
+	var out []*ateapipb.Limits
+	if cpu := limits.GetCpu(); cpu != "" {
+		out = append(out, &ateapipb.Limits{Name: "cpu", Quantity: cpu})
+	}
+	if mem := limits.GetMemory(); mem != "" {
+		out = append(out, &ateapipb.Limits{Name: "memory", Quantity: mem})
+	}
+	if len(out) == 0 {
+		return nil
+	}
+	return &ateapipb.Resources{Limits: out}
+}
